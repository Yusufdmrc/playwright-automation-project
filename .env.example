# Ortam değişkenleri şablonu.
# Bu dosyayı kopyalayıp ".env" olarak kaydet ve gerçek değerleri gir.
# .env dosyası .gitignore'da tanımlı — asla Git'e gitmez!

# Uygulamanın temel URL'i
BASE_URL=https://automationexercise.com

# Tarayıcı seçimi: chromium | firefox | webkit
BROWSER=chromium

# Headless mod: true (CI/CD için) | false (lokal debug için)
HEADLESS=true

# Test zaman aşımı (milisaniye)
TIMEOUT=30000

